{
  "name": "consent-desk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Consent Desk — an agent operations layer that lets an AI agent act on a person's private data without ever seeing it. Built on Terminal 3 (T3N).",
  "scripts": {
