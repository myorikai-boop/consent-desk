# Tenant (your organisation) key — claim at https://www.terminal3.io/claim-page
T3N_API_KEY=

# The agent's OWN key. Never reuse the tenant key for an agent.
AGENT_KEY=
# Filled in automatically after the agent's first authenticate() — read it back, never derive it.
AGENT_DID=

# z:<tid>:<tail> of the tenant contract the agent is allowed to call
TENANT_CONTRACT=
CONTRACT_VERSION=1.0.0

T3N_ENV=testnet
PORT=8787
AUDIT_LOG=./data/audit.jsonl
